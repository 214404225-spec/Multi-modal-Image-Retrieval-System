# 复制本文件为 .env 并按需修改（agent_pipeline/pipeline.py 会通过 python-dotenv 自动加载）
# 注意：已存在的环境变量优先级高于 .env 中的值

# 意图识别 LLM（Ollama 模型名）
INTENT_MODEL=qwen3:8b

# VL 精排模型（Ollama 模型名）
VL_MODEL=qwen3-vl:8b

# VL 精排并行 worker 数（1=串行；单 GPU 下并行无收益，详见 README「已知限制」）
VL_PARALLEL_WORKERS=1

# 常规检索索引规模（-1=全部图像）
REGULAR_INDEX_SIZE=-1

# HuggingFace 端点（国内网络可改为镜像）
#HF_ENDPOINT=https://hf-mirror.com
